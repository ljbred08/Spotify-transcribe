# Copy to .env and fill in what you have. Everything is optional.

# Transcription backend: auto | parakeet | groq | openai
# (local model choice + downloads are managed in the app UI, ⚙ Models panel;
#  those settings persist in data/settings.json and override this default)
TRANSCRIBE_BACKEND=auto

# Optional legacy local backend (faster-whisper, pip install ".[whisper]")
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto

# Cloud backends (fast, word timestamps included). get a key, drop it here.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

# yt-dlp: used directly for YouTube/other URLs, and as the fetcher for the
# YouTube video that a Spotify URL resolves to. If downloads get blocked,
# export your browser cookies for youtube.com to cookies.txt here, and/or
# pass extra CLI flags (comma-separated) below.
YTDLP_COOKIES_FILE=cookies.txt
YTDLP_EXTRA=--extractor-args,youtube:player_client=web

# Download pipeline
JOB_CONCURRENCY=1
APP_DATA_DIR=data
