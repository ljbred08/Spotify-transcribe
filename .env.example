# Copy to .env and fill in what you have. Everything is optional.

# Transcription backend: auto | local | groq | openai
TRANSCRIBE_BACKEND=auto

# Local Whisper (faster-whisper): tiny base small medium large-v3
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto

# Cloud backends (fast, word timestamps included). get a key, drop it here.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

# yt-dlp: where the audio actually comes from. If a Spotify URL stops resolving,
# export your browser cookies for youtube.com to cookies.txt here, and/or pass
# extra CLI flags (comma-separated) below.
YTDLP_COOKIES_FILE=cookies.txt
YTDLP_EXTRA=--extractor-args,youtube:player_client=web

# Download pipeline
JOB_CONCURRENCY=1
APP_DATA_DIR=data
