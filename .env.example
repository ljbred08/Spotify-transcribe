[TEMPLATE]
# Copy to .env and fill in what you have. Everything is optional.

# Cloud transcription — set at least one key. Model choice + formatter
# provider are managed in the app UI (⚙ Transcription models panel) and
# persist in data/settings.json.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# yt-dlp: used directly for YouTube/other URLs, and as the fetcher for the
# YouTube video that a Spotify URL resolves to. If downloads get blocked,
# export your browser cookies for youtube.com to cookies.txt here, and/or
# pass extra CLI flags (comma-separated) below.
YTDLP_COOKIES_FILE=cookies.txt
YTDLP_EXTRA=--extractor-args,youtube:player_client=web

# Download pipeline
JOB_CONCURRENCY=1
APP_DATA_DIR=data
